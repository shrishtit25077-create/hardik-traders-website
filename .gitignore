# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
backend/node_modules/

# ─── Environment variables (NEVER commit secrets) ────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
backend/.env
backend/.env.local

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/
out/
.vite/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Test / Coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Uploads (user-generated content) ────────────────────────────────────────
backend/uploads/

# ─── OS & Editor junk ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── Temporary files ─────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.cache

# ─── Package manager locks (keep package-lock, ignore yarn/pnpm) ─────────────
yarn.lock
pnpm-lock.yaml

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
